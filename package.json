{
  "name": "modheaderx",
  "version": "2.3.2",
  "private": true,
  "license": "MIT",
  "description": "Modify HTTP request and response headers (MV3 rewrite: WXT + React + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@msgpack/msgpack": "^3.1.3",
    "@mui/material": "^9.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "ws": "^8.22.0",
    "wxt": "^0.21.3"
  }
}
